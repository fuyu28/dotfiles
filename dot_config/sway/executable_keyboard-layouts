#!/usr/bin/env python3
"""Apply per-device layouts under sway.

Names match ~/.config/i3/scripts/set-keyboard-layouts. The built-in keyboard
is also set in the sway config; this covers MX Keys when it is connected.
"""

import json
import subprocess

layouts = {
    "AT Translated Set 2 keyboard": "jp",
    "MX Keys M Mac Keyboard": "us",
}

inputs = json.loads(subprocess.check_output(["swaymsg", "-t", "get_inputs"], text=True))
for dev in inputs:
    if dev.get("type") != "keyboard":
        continue
    layout = layouts.get(dev.get("name"))
    if layout is None:
        continue
    subprocess.run(
        ["swaymsg", f'input "{dev["identifier"]}" xkb_layout {layout}'],
        check=True,
    )
