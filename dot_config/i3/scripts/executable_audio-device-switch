#!/usr/bin/env bash
set -euo pipefail

# Cycle the PipeWire default output. Existing streams keep their current
# destination; applications opened afterwards use the new default.
#
# 何も挿さっていないヘッドホン端子や HDMI も sink として見えるが、
# そこへ set-default しても WirePlumber が受け付けず元の出力に戻る。
# そのため有効なポートを持つ sink だけを巡回する。
mapfile -t sinks < <(
  LC_ALL=C pactl list sinks | awk '
    function flush() {
      if (name != "" && !(active in unavailable)) print name
      name = ""; active = ""; delete unavailable
    }
    /^Sink #/ { flush(); next }
    /^\tName: / { name = $2; next }
    # ポート行: "\t\t<port>: <desc> (type: ..., not available)"
    /^\t\t[^\t]/ && /not available\)$/ {
      port = $0
      sub(/^\t\t/, "", port)
      sub(/: .*/, "", port)
      unavailable[port] = 1
      next
    }
    /^\tActive Port: / { active = $0; sub(/^\tActive Port: /, "", active); next }
    END { flush() }
  '
)

(( ${#sinks[@]} > 0 )) || {
  notify-send -u critical "Audio output" "No output device found"
  exit 1
}

current=$(pactl get-default-sink)

next=${sinks[0]}
for index in "${!sinks[@]}"; do
  if [[ "${sinks[$index]}" == "$current" ]]; then
    next=${sinks[$(( (index + 1) % ${#sinks[@]} ))]}
    break
  fi
done

pactl set-default-sink "$next"
name=$(LC_ALL=C pactl list sinks | awk -v n="$next" '
  /^\tName: / { found = ($2 == n); next }
  found && /^\tDescription: / { sub(/^\tDescription: /, ""); print; exit }
')
notify-send -i audio-volume-high "Audio output switched" "${name:-$next}"
