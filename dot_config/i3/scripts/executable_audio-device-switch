#!/usr/bin/env bash
set -euo pipefail

# Cycle the PipeWire default output. Existing streams keep their current
# destination; applications opened afterwards use the new default.
mapfile -t sinks < <(
  wpctl status -n | awk '
    /Sinks:/ { in_sinks = 1; next }
    in_sinks && /Sources:/ { exit }
    in_sinks && match($0, /[0-9]+\./) {
      print substr($0, RSTART, RLENGTH - 1)
    }
  '
)

(( ${#sinks[@]} > 0 )) || {
  notify-send -u critical "Audio output" "No output device found"
  exit 1
}

current=$(wpctl status -n | awk '
  /Sinks:/ { in_sinks = 1; next }
  in_sinks && /Sources:/ { exit }
  in_sinks && /\*/ && match($0, /[0-9]+\./) {
    print substr($0, RSTART, RLENGTH - 1)
    exit
  }
')

next=${sinks[0]}
for index in "${!sinks[@]}"; do
  if [[ "${sinks[$index]}" == "$current" ]]; then
    next=${sinks[$(( (index + 1) % ${#sinks[@]} ))]}
    break
  fi
done

wpctl set-default "$next"
name=$(wpctl inspect "$next" | awk -F'"' '/node.description/ { print $2; exit }')
notify-send -i audio-volume-high "Audio output switched" "${name:-Node $next}"
