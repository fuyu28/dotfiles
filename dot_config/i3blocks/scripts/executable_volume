#!/usr/bin/env bash
# i3blocks volume block for PipeWire/WirePlumber.

STEP=${1:-5%}

# Handle scroll/middle-click
case "$BLOCK_BUTTON" in
    3) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;  # right click = mute/unmute
    4) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}+" ;; # scroll up
    5) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}-" ;; # scroll down
esac

status=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || {
    echo "No audio"
    exit 0
}
VOL=$(awk '{printf "%d", $2 * 100}' <<<"$status")
MUTED=no
[[ "$status" == *"[MUTED]"* ]] && MUTED=yes

# Choose symbol
AUDIO_HIGH=''
AUDIO_MED=''
AUDIO_LOW=''
AUDIO_MUTED=''
MED_THRESH=50
LOW_THRESH=0

if [[ "$MUTED" == "no" ]]; then
    SYMB=$AUDIO_HIGH
    [[ $VOL -le $MED_THRESH ]] && SYMB=$AUDIO_MED
    [[ $VOL -le $LOW_THRESH ]] && SYMB=$AUDIO_LOW
else
    SYMB=$AUDIO_MUTED
fi

# Single-line output for i3blocks
echo "${SYMB} ${VOL}%"
