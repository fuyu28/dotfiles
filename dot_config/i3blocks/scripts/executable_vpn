#!/usr/bin/env python3
"""Show active VPN connection names managed or detected by NetworkManager."""

import subprocess

try:
    result = subprocess.run(
        ["nmcli", "-t", "--escape", "no", "-f", "TYPE,NAME",
         "connection", "show", "--active"],
        capture_output=True, text=True, check=True, timeout=4,
    )
except (OSError, subprocess.SubprocessError):
    print("VPN: Unknown")
else:
    names = []
    for line in result.stdout.splitlines():
        kind, separator, name = line.partition(":")
        if separator and kind in {"vpn", "wireguard", "tun"} and name not in names:
            names.append(name)
    print("VPN: " + ", ".join(names) if names else "")
