#!/usr/bin/env python3
"""Show active VPN connection names managed or detected by NetworkManager."""

import json
import subprocess


def tailscale_running():
    """The TUN device can persist after `tailscale down`."""
    try:
        result = subprocess.run(
            ["tailscale", "status", "--json"],
            capture_output=True, text=True, check=True, timeout=2,
        )
        status = json.loads(result.stdout)
        return isinstance(status, dict) and status.get("BackendState") == "Running"
    except (OSError, subprocess.SubprocessError, ValueError):
        return False


try:
    result = subprocess.run(
        ["nmcli", "-t", "--escape", "no", "-f", "TYPE,NAME,DEVICE",
         "connection", "show", "--active"],
        capture_output=True, text=True, check=True, timeout=4,
    )
except (OSError, subprocess.SubprocessError):
    print("VPN: Unknown")
else:
    names = []
    for line in result.stdout.splitlines():
        kind, separator, connection = line.partition(":")
        name, device_separator, device = connection.rpartition(":")
        if not device_separator:
            continue
        if device == "tailscale0" and not tailscale_running():
            continue
        if separator and kind in {"vpn", "wireguard", "tun"} and name not in names:
            names.append(name)
    print("VPN: " + ", ".join(names) if names else "")
