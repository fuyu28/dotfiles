# Repository-only files
README.md
# Installed to /etc/X11/xorg.conf.d by .chezmoiscripts/linux/run_onchange_after_50-install-xorg-config.sh
xorg.conf.d/**

{{ if not .private -}}
# 壁紙は private リポジトリにある
Pictures
{{ end -}}
{{ if not .skk -}}
# SKK を使わないマシンでは設定・辞書を置かない
.config/fcitx5/conf/skk.conf
.config/libskk
.local/share/fcitx5/skk
{{- end }}

{{- $i3 := has "i3" .desktops -}}
{{- $sway := has "sway" .desktops -}}
{{- $kde := has "kde" .desktops -}}
{{ if not $i3 -}}
# sway も ~/.config/i3/scripts を使うので、i3 本体の設定だけ外す
.config/i3/config
.config/i3/keybindings
.config/picom
{{ end -}}
{{ if not $sway -}}
.config/sway
.config/swaylock
.config/xdg-desktop-portal
.local/bin/start-sway
.local/share/wayland-sessions
{{ end -}}
{{ if not (or $i3 $sway) -}}
.config/i3
.config/i3blocks
.config/dunst
{{ end -}}
{{ if not $kde -}}
.config/autostart/baloo_file.desktop
{{ end -}}
{{ if not (and $kde (or $i3 $sway)) -}}
# i3 / sway と Plasma を併用するときだけ、Plasma のユニットを止めて戻す
.config/autostart/restore-plasma-units.desktop
.config/i3/scripts/block-plasma
.config/i3/scripts/restore-plasma-units
{{ end }}
{{ if ne .chezmoi.os "linux" -}}
{{ template "ignore/linux" . }}
{{- end }}
{{ if ne .chezmoi.os "darwin" -}}
{{ template "ignore/darwin" . }}
{{- end }}
