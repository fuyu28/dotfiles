{{- if eq .chezmoi.osRelease.id "endeavouros" -}}
{{- /* パッケージの一覧は .chezmoidata/packages.toml にある */ -}}
{{- $pacman := .packages.pacman.required -}}
{{- $aur := .packages.aur.required -}}
{{- range .desktops -}}
{{-   $desktop := index $.packages.desktops . -}}
{{-   $pacman = concat $pacman $desktop.pacman -}}
{{-   $aur = concat $aur $desktop.aur -}}
{{- end -}}
{{- range .packageGroups -}}
{{-   $group := index $.packages.groups . -}}
{{-   $pacman = concat $pacman $group.pacman -}}
{{-   $aur = concat $aur $group.aur -}}
{{- end -}}
#!/bin/bash
set -euo pipefail

pacman_pkgs=(
{{- range $pacman | uniq }}
  {{ . }}
{{- end }}
)

aur_pkgs=(
{{- range $aur | uniq }}
  {{ . }}
{{- end }}
)

# pacman -T prints only the packages that are not installed yet.
missing_pacman=$(pacman -T "${pacman_pkgs[@]}" || true)
missing_aur=$(pacman -T "${aur_pkgs[@]}" || true)

# -Syu instead of -S: a stale sync database fetches removed versions (404),
# and -Sy alone would be a partial upgrade.
if [[ -n $missing_pacman ]]; then
  # shellcheck disable=SC2086
  sudo pacman -Syu --needed --noconfirm $missing_pacman
fi
if [[ -n $missing_aur ]]; then
  # shellcheck disable=SC2086
  paru -S --needed --noconfirm $missing_aur
fi
{{- end }}
