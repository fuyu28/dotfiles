{{- if includeTemplate "host/arch" . | eq "true" -}}
{{- /* パッケージの一覧と、どのテーブルを入れるかは .chezmoidata/packages.toml にある */ -}}
{{- $gui := .gui -}}
{{- $eos := includeTemplate "host/endeavouros" . | eq "true" -}}
{{- $tables := list .packages.base -}}
{{- if not (includeTemplate "host/wsl" . | eq "true") -}}
{{-   $tables = append $tables .packages.hardware -}}
{{- end -}}
{{- if $gui -}}
{{-   $tables = append $tables .packages.desktop -}}
{{-   range .desktops -}}
{{-     $tables = append $tables (index $.packages.desktops .) -}}
{{-   end -}}
{{- end -}}
{{- range .packageGroups -}}
{{-   $tables = append $tables (index $.packages.groups .) -}}
{{- end -}}
{{- $pacman := list -}}
{{- $aur := list -}}
{{- range $tables -}}
{{-   $r := includeTemplate "arch/collect-packages" (dict "table" . "gui" $gui "eos" $eos) | fromJson -}}
{{-   with $r.pacman }}{{ $pacman = concat $pacman . }}{{ end -}}
{{-   with $r.aur }}{{ $aur = concat $aur . }}{{ end -}}
{{- end -}}
#!/bin/bash
set -euo pipefail

pacman_pkgs=(
{{- range $pacman | uniq }}
  {{ . }}
{{- end }}
)

aur_pkgs=(
{{- range $aur | uniq }}
  {{ . }}
{{- end }}
)

# pacman -T prints only the packages that are not installed yet.
missing_pacman=$(pacman -T "${pacman_pkgs[@]}" || true)
missing_aur=$(pacman -T "${aur_pkgs[@]}" || true)

# -Syu instead of -S: a stale sync database fetches removed versions (404),
# and -Sy alone would be a partial upgrade.
if [[ -n $missing_pacman ]]; then
  # shellcheck disable=SC2086
  sudo pacman -Syu --needed --noconfirm $missing_pacman
fi
if [[ -n $missing_aur ]]; then
  if command -v paru >/dev/null; then
    # shellcheck disable=SC2086
    paru -S --needed --noconfirm $missing_aur
  else
    # Arch Linux には paru が公式リポジトリにないので、入れるまで AUR は飛ばす
    printf '%s\n' "AUR packages skipped: paru is not installed:" "$missing_aur" >&2
  fi
fi
{{- end }}
