[user]
	name = fuyu
	email = fuyu28.dev@gmail.com
{{- if eq .chezmoi.os "windows" }}
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[credential]
	helper = manager
[core]
	# git status を速くする（starship のプロンプトが軽くなる）
	fsmonitor = true
	untrackedCache = true
{{- else if eq .chezmoi.os "darwin" }}
{{- /* Homebrew の場所は Apple Silicon と Intel で違う */}}
{{- $brew := ternary "/opt/homebrew" "/usr/local" (eq .chezmoi.arch "arm64") }}
[credential "https://github.com"]
	helper = 
	helper = !{{ $brew }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ $brew }}/bin/gh auth git-credential
[credential]
	helper = osxkeychain
{{- else }}
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
{{- if .gui }}
{{- /* libsecret はデスクトップのキーリングを使うので、GUI がない端末では設定しない */}}
[credential]
	helper = /usr/lib/git-core/git-credential-libsecret
{{- end }}
{{- end }}
[init]
	defaultBranch = main
[core]
	# 日本語のファイル名をエスケープせずに表示する
	quotepath = false
# マシン固有の設定（safe.directory やパスなど）は chezmoi で管理しない
[include]
	path = ~/.gitconfig.local
