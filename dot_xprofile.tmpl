# fcitx5
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx

# PORTAL の有効化（Slack 外部ブラウザ対応）
export GTK_USE_PORTAL=1

# XDG_DATA_DIRS の補完（Flatpak / icons / themes の検索パス）
export XDG_DATA_DIRS="${HOME}/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"

# カーソル
export XCURSOR_THEME={{ .cursor.theme }}
# XCURSOR_SIZE would override Xcursor.size, which display-scale sets per screen.
unset XCURSOR_SIZE

# LightDM は Wayland セッションでもこのファイルを読む。その時点では DISPLAY が空。
# X11 専用の処理はそこで止める。xrdb は Xsession ラッパーも呼ぶので、画面が無いときは無効化する。
if [ -z "${DISPLAY:-}" ]; then
  xrdb() { return 0; }
  return 0 2>/dev/null || true
fi

# デスクトップ偽装（GTK にダークテーマを使わせる）
export XDG_CURRENT_DESKTOP=GNOME

# kitty on X11. On Wayland this makes fcitx skip the text-input protocol.
export GLFW_IM_MODULE=ibus

# Portal backends の起動（i3 は自動起動しない）
/usr/lib/xdg-desktop-portal &
/usr/lib/xdg-desktop-portal-gtk &

xrdb -merge "$HOME/.Xresources"
