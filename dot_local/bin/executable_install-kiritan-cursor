#!/usr/bin/env python3
"""Convert the Kiritan Windows cursor pack into an Xcursor theme.

The pack may not be redistributed, so this repository keeps only the
converter. Usage:

    install-kiritan-cursor ~/Downloads/cursors/きりたんカーソル.zip

The theme goes to ~/.local/share/icons/Kiritan, which both X11 (libXcursor)
and sway (wlroots) search. The 32px pixel art is enlarged by whole multiples
with nearest-neighbour sampling, then reduced to sizes that are not a
multiple, so every scale gets an exact size instead of a blurry resample.
"""

import io
import pathlib
import shutil
import struct
import sys
import tempfile
import zipfile

from PIL import Image

THEME = "Kiritan"
SOURCE_SIZE = 32
SIZES = (24, 32, 40, 48, 64, 80, 96)
# Animated cursors fall back to this when an .ani file has no rate chunk.
JIFFY_MS = 1000 / 60

# Windows role in the file name -> Xcursor names (CSS names first, then the
# legacy X11 aliases that older toolkits still request).
CURSORS = {
    "通常の選択": ["default", "left_ptr", "arrow", "top_left_arrow"],
    "ヘルプの選択": ["help", "question_arrow", "whats_this", "left_ptr_help"],
    "バックグラウンドで作業中": ["progress", "left_ptr_watch", "half-busy"],
    "待ち状態": ["wait", "watch"],
    "テキスト選択": ["text", "xterm", "ibeam", "vertical-text"],
    "利用不可": ["not-allowed", "no-drop", "forbidden", "crossed_circle", "circle"],
    "上下に拡大縮小": [
        "ns-resize", "row-resize", "n-resize", "s-resize", "size_ver",
        "sb_v_double_arrow", "v_double_arrow", "top_side", "bottom_side",
    ],
    "左右に拡大縮小": [
        "ew-resize", "col-resize", "e-resize", "w-resize", "size_hor",
        "sb_h_double_arrow", "h_double_arrow", "left_side", "right_side",
    ],
    "斜めに拡大縮小1": [
        "nwse-resize", "nw-resize", "se-resize", "size_fdiag",
        "bd_double_arrow", "top_left_corner", "bottom_right_corner",
    ],
    "斜めに拡大縮小2": [
        "nesw-resize", "ne-resize", "sw-resize", "size_bdiag",
        "fd_double_arrow", "top_right_corner", "bottom_left_corner",
    ],
    "移動": ["move", "all-scroll", "fleur", "size_all", "grabbing"],
    "リンクの選択": ["pointer", "hand", "hand1", "hand2", "pointing_hand"],
}


def riff_chunks(data, offset, end):
    while offset + 8 <= end:
        chunk_id = data[offset:offset + 4]
        (length,) = struct.unpack("<I", data[offset + 4:offset + 8])
        yield chunk_id, offset + 8, length
        offset += 8 + length + (length & 1)


def read_ani(data):
    """Return [(image, (xhot, yhot), delay_ms)] in playback order."""
    if data[:4] != b"RIFF" or data[8:12] != b"ACON":
        raise ValueError("not an animated cursor")
    frames, rates, sequence, default_rate = [], None, None, 1
    for chunk_id, offset, length in riff_chunks(data, 12, len(data)):
        body = data[offset:offset + length]
        if chunk_id == b"anih":
            default_rate = struct.unpack("<9I", body[:36])[7]
        elif chunk_id == b"rate":
            rates = struct.unpack(f"<{length // 4}I", body)
        elif chunk_id == b"seq ":
            sequence = struct.unpack(f"<{length // 4}I", body)
        elif chunk_id == b"LIST" and body[:4] == b"fram":
            for icon_id, icon_offset, icon_length in riff_chunks(body, 4, length):
                if icon_id != b"icon":
                    continue
                cur = body[icon_offset:icon_offset + icon_length]
                # CUR directory entry: planes/bit count hold the hotspot.
                hotspot = struct.unpack("<HH", cur[10:14])
                image = Image.open(io.BytesIO(cur))
                image.load()
                frames.append((image.convert("RGBA"), hotspot))
    steps = sequence or range(len(frames))
    playback = []
    for step, index in enumerate(steps):
        jiffies = rates[step] if rates else default_rate
        image, hotspot = frames[index]
        playback.append((image, hotspot, max(1, round(jiffies * JIFFY_MS))))
    return playback


def resize(image, size):
    factor = -(-size // SOURCE_SIZE)
    sharp = image.resize((SOURCE_SIZE * factor,) * 2, Image.NEAREST)
    if sharp.width == size:
        return sharp
    return sharp.resize((size, size), Image.LANCZOS)


def premultiplied_argb(image):
    raw = image.tobytes()
    pixels = bytearray()
    for index in range(0, len(raw), 4):
        red, green, blue, alpha = raw[index:index + 4]
        pixel = (alpha << 24
                 | (red * alpha // 255) << 16
                 | (green * alpha // 255) << 8
                 | blue * alpha // 255)
        pixels += struct.pack("<I", pixel)
    return bytes(pixels)


def xcursor(playback):
    """Encode every size of every frame into one Xcursor file."""
    images = []
    for size in SIZES:
        for image, (xhot, yhot), delay in playback:
            scaled = resize(image, size)
            hot = [min(size - 1, round(value * size / SOURCE_SIZE)) for value in (xhot, yhot)]
            header = struct.pack("<9I", 36, 0xFFFD0002, size, 1, size, size, *hot, delay)
            images.append((size, header + premultiplied_argb(scaled)))
    position = 16 + 12 * len(images)
    table, chunks = b"", b""
    for size, chunk in images:
        table += struct.pack("<3I", 0xFFFD0002, size, position)
        chunks += chunk
        position += len(chunk)
    return struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(images)) + table + chunks


def extract(archive, destination):
    with zipfile.ZipFile(archive) as bundle:
        for member in bundle.infolist():
            name = member.filename
            if not member.flag_bits & 0x800:
                # Windows zip without the UTF-8 flag: names are Shift_JIS.
                name = name.encode("cp437").decode("cp932")
            path = destination / pathlib.PurePosixPath(name).name
            if member.is_dir() or not path.name.endswith(".ani"):
                continue
            path.write_bytes(bundle.read(member))


def main():
    if len(sys.argv) != 2:
        sys.exit(f"usage: {pathlib.Path(sys.argv[0]).name} <きりたんカーソル.zip>")
    target = pathlib.Path.home() / ".local/share/icons" / THEME
    with tempfile.TemporaryDirectory() as work:
        source = pathlib.Path(work)
        extract(sys.argv[1], source)
        cursors = source / "cursors"
        cursors.mkdir()
        for role, names in CURSORS.items():
            matches = list(source.glob(f"*_{role}.ani"))
            if len(matches) != 1:
                sys.exit(f"{role}: expected one .ani file, found {len(matches)}")
            (cursors / names[0]).write_bytes(xcursor(read_ani(matches[0].read_bytes())))
            for alias in names[1:]:
                (cursors / alias).symlink_to(names[0])
        # Cursors the pack does not draw (crosshair, cell, ...) come from Adwaita.
        (source / "index.theme").write_text(
            f"[Icon Theme]\nName={THEME}\nComment=Kiritan cursors\nInherits=Adwaita\n"
        )
        if target.exists():
            shutil.rmtree(target)
        target.mkdir(parents=True)
        shutil.copytree(cursors, target / "cursors", symlinks=True)
        shutil.copy(source / "index.theme", target)
    print(f"Installed {THEME} to {target}")


if __name__ == "__main__":
    main()
